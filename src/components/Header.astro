---
import { languages } from '../i18n/ui';
import { getLangFromUrl, getTargetUrl} from '../i18n/utils';
import '../styles/header.css';

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
---

<header>
    <div class="owner">
        <p class="name">Gabriel Benedito de Negri</p>
        <p class="jobTitle">Fullstack Developer</p>
    </div>
    <div class="tabs">
        <a class="tab" href="">Works</a>
        <a class="tab" href="">Projects</a>
        <a class="tab" href="">Education</a>
    </div>
    <div class="contacts">
        <label>Contacts:</label>
        <div class="icon-container">
            <a href="https://www.github.com/Bielnegri">
                <img class="icon" src="/github.png" alt="GitHub">
            </a>
        </div>
        <div class="icon-container">
            <a href="https://www.linkedin.com/in/gabriel-benedito-de-negri">
                <img class="icon" src="/linkedin.png" alt="Linkedin">
            </a>
        </div>
        <div class="icon-container">
            <a href="mailto:gabrielbnegri@gmail.com">
                <img class="icon" src="/enviar.png" alt="Linkedin">
            </a>
        </div> <!-- Link para email -->
    </div>
    <div class="language">
        <a href="">
            <img src="/brazil.png" alt="PT">
        </a>
        <a href="">
            <img src="/usa.png" alt="EN">
        </a>
        <a href={getTargetUrl(currentPath, currentLang,'es')} class:list={[{ active: currentLang === 'es' }]}>
            <img src="/spain.png" alt="ES">
        </a>
    </div>    
</header>