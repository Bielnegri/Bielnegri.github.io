---
import { getLangFromUrl, getTargetUrl, useTranslations} from '../i18n/utils';
import '../styles/header.css';

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<header>
    <div class="owner">
        <p class="name">Gabriel Benedito de Negri</p>
        <p class="jobTitle">{t("title.jobTitle")}</p>
    </div>
    <div class="tabs">
        <a class="tab" href={`/${currentLang}#works`}>{t("tabs.works")}</a>
        <a class="tab" href={`/${currentLang}#projects`}>{t("tabs.projects")}</a>
        <a class="tab" href={`/${currentLang}#education`}>{t("tabs.education")}</a>
    </div>
    <div class="contacts">
        <label>{t("contacts.title")}:</label>
        <a href="https://www.github.com/Bielnegri">
            <img class="icon" src="/github.png" alt="GitHub">
        </a>
        <a href="https://www.linkedin.com/in/gabriel-benedito-de-negri">
            <img class="icon" src="/linkedin.png" alt="Linkedin">
        </a>
        <a href="mailto:gabrielbnegri@gmail.com">
            <img class="icon" src="/enviar.png" alt="Linkedin">
        </a>
    </div>
    <div class="language">
        <a href={getTargetUrl(currentPath, currentLang,'pt')} class:list={[{active: currentLang === 'pt'}]}>
            <img src="/brazil.png" alt="PT">
        </a>
        <a href={getTargetUrl(currentPath, currentLang,'en')} class:list={[{active: currentLang === 'en'}]}>
            <img src="/usa.png" alt="EN">
        </a>
        <a href={getTargetUrl(currentPath, currentLang,'es')} class:list={[{active: currentLang === 'es'}]}>
            <img src="/spain.png" alt="ES">
        </a>
    </div>    
</header>